<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.g8.nzd-b2</string>
    <key>ProgramArguments</key>
    <array><string>/bin/zsh</string><string>/Users/sanderbignotte/Trading_Sander/g8-nzd/nzd_local_run.sh</string></array>
    <!-- v1.4 (acta P-5, 1-oct-2026): UNA ejecución diaria a las 19:30 hora del Mac (Bata, UTC+1, sin cambio de hora),
         antes de la ejecución final de Actions (~21:30Z): recoge B2 de NZ, SNB (RSS, curva, zirepo) y TONA del día.
         RunAtLoad + launchd (si el Mac dormía a las 19:30 lanza al despertar) recuperan la ejecución perdida;
         nzd_local_run.sh v1.5 no repite si la de este turno ya terminó bien («ya hecho»).
         Despertar: sudo pmset repeat wakeorpoweron MTWRFSU 19:25:00 (lo ejecuta el operador). -->
    <!-- v1.5 (acta P-5): 21:00 = reintento. Con el turno de las 19:30 ya hecho, nzd_local_run.sh sale sin hacer nada;
         si falló, lo repite (segunda oportunidad en 24 h, regla de cobertura de sources/schedules.csv). -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>19</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Hour</key><integer>21</integer><key>Minute</key><integer>0</integer></dict>
    </array>
    <key>RunAtLoad</key><true/>
    <key>StandardOutPath</key><string>/Users/sanderbignotte/Trading_Sander/g8-nzd/logs/launchd.out</string>
    <key>StandardErrorPath</key><string>/Users/sanderbignotte/Trading_Sander/g8-nzd/logs/launchd.err</string>
</dict>
</plist>

# Python virtual environment (never commit — hundreds of MB of binaries)
venv/
*.pyc
__pycache__/

# Generated validation output (regenerated each run by validate_inputs.py)
data/validation_report.json

# macOS noise
.DS_Store
*.yml.bak
data/s01b/.lock
data/s01b/.staging/
data/s01b/**/*.tmp

# acta P-6: área de trabajo del agente de mantenimiento (informe, bundle) — nunca se comitea
.agent/

# t186u (Sander, 15-nov-2026) and t189u (Sander, 15-nov-2026): compressed
# Databento originals stay local or as Actions artifacts. Never commit them.
# volume_only archives under data/options/raw/ when it is not pointed at runner temp.
data/options/raw/
*.dbn
*.dbn.zst

# t245u (Sander, 18-nov-2026): CME rows live in g8-macro-data.
# git add of these paths must not republish them on the public tree.
data/options/canonical/**
!data/options/canonical/.gitkeep
data/options/volume_shadow/
data/options/fxvol_history.csv
data/options/shadow_history.json
data/options/backfill_report.json
data/options/volume_backfill_report.json
# t246u: los tres stubs UNAVAILABLE sí se versionan. El resto de cifras CME no.

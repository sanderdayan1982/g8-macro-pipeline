[Unit]
Description=G8 VPS · Metals Fair Value proyección SHADOW B2 L–V (t354u) · no es un turno del dispatcher
OnFailure=g8-alarm@%n.service
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=g8
Group=g8
Environment=G8_MODE=prod
Environment=G8_VPS_JOB=metals-shadow
Environment=G8_METALS_LOCK=/srv/g8/prod/state/locks/metals-shadow.lock
Environment=G8_METALS_FEED_LOCK=/srv/g8/prod/state/locks/metals-feed.lock
Environment=G8_ALERTAS_LOG=/srv/g8/logs/ALERTAS.log
Environment=G8_METALS_WORKDIR=/srv/g8/prod/work/metals-shadow
Environment=G8_VPS_JOB_STATE=/srv/g8/prod/state/vps_jobs/metals-shadow.json
EnvironmentFile=/etc/g8/secrets.env
ExecStart=/srv/g8/venv/bin/python /srv/g8/bin/metals_vps.py --job metals-shadow
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/srv/g8/prod/work /srv/g8/prod/state /srv/g8/logs
TimeoutStartSec=1800
